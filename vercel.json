{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aurelio-chasmy-dorsiventrally.ngrok-free.dev/api/:path*"
    },
    {
      "source": "/events",
      "destination": "https://aurelio-chasmy-dorsiventrally.ngrok-free.dev/events"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
