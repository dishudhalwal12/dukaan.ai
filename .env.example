# ─────────────────────────────────────────────────────────────────────────────
# Dukaan.AI — frontend environment (Vite)
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# ⚠️  Every variable prefixed with `VITE_` is INLINED INTO THE BROWSER BUNDLE.
#     Treat all of them as public. Never put a `service_role` key, a database
#     password, or a private API credential in this file or in any VITE_* var.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (cloud sync + Google OAuth) ─────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
# The anon/publishable key is designed to be shipped to browsers; it is only
# safe if Row Level Security is enabled on every table (see supabase_schema.sql).
# Leaving these blank is supported: the app runs in local-only guest mode.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AI (OpenRouter) ─────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
# This key is bundled into the browser build — restrict it (spend limit, and
# rotate it if the repository or a built bundle is ever made public).
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# ── Optional: self-hosted / local OpenAI-compatible LLM ──────────────────────
# When set, the frontend prefers this endpoint over OpenRouter.
# VITE_LLM_BASE_URL=http://localhost:8080/v1
