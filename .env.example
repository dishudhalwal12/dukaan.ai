# ─────────────────────────────────────────────────────────────────────────────
# Dukaan.AI — THE environment file. One file, every key.
#
#     cp .env.example .env      # then fill in your values
#
# To change any key later, edit `.env` and restart:
#     sudo systemctl restart dukaan-bot
#
# ⚠️  VITE_* variables are INLINED INTO THE PUBLIC BROWSER BUNDLE. Anyone can
#     read them. Never put a server key, a `service_role` key, or a database
#     password in a VITE_ variable. Everything WITHOUT the VITE_ prefix stays on
#     the server and is never sent to a browser.
#
# ⚠️  Precedence: an exported shell/systemd variable WINS over this file
#     (dotenv's default). Keep a key you are not using commented out rather than
#     present-but-empty.
#
# ⚠️  `.env` is git-ignored. Never commit it. Rotate a key here and in the
#     provider dashboard, then restart the bot, if it is ever exposed.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase: browser side (safe to publish) ─────────────────────────────────
# Supabase dashboard → Project Settings → API. The anon/publishable key is
# designed to be shipped to browsers, but only if Row Level Security is enabled
# on every table (see supabase_schema.sql).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# ── Supabase: server side (SECRET — never reaches the browser) ───────────────
# The same project URL, and the SERVICE ROLE key. The bot uses this to read the
# shop registry and mirror orders, and to verify a shopkeeper's access token.
# Use the service key specifically: the project's RLS has no anon policies on
# business_profiles / products / orders, so an anon key reads nothing.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Some Supabase dashboards label the same key SUPABASE_SERVICE_ROLE_KEY; either
# name works, and this one is only consulted if the line above is empty.
SUPABASE_SERVICE_ROLE_KEY=


# ── AI providers (SECRET — read only by the bot) ─────────────────────────────
# The browser never sees these: the client calls this bot's /api/ai/* route and
# the bot calls the provider. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
GROQ_API_KEY=
GROQ_MODEL=


# ── Self-hosted / local OpenAI-compatible model (optional) ───────────────────
# Only uncomment if a local model server is actually running. While it is set
# and unreachable, every message the cloud providers fail costs a full abort.
# LLM_BASE_URL=http://127.0.0.1:8080/v1/chat/completions
# LLM_MODEL_NAME=models/dukaan-qwen-1.5b-fused-4bit


# ── Frontend wiring (safe to publish) ────────────────────────────────────────
# The origin the browser calls for /api and /events. Leave EMPTY when the
# frontend is served by the bot itself (same origin); set it to the public
# backend URL when the static site is hosted elsewhere (e.g. Vercel).
#   Deployed on Vercel → https://<your-ngrok-domain>.ngrok-free.dev
VITE_API_BASE=
# The support number shown in Help & Support and Settings. Digits with country
# code, e.g. 919876543210. Leave EMPTY to hide the "Call Us" action entirely —
# there is no built-in default, so the app never dials a number nobody chose.
VITE_SUPPORT_WHATSAPP=
# Shown in the UI; set by CI to the commit being deployed.
# VITE_APP_VERSION=


# ── Access control (SECRET) ──────────────────────────────────────────────────
# Comma-separated Supabase user ids allowed to reach operator-only routes
# (send as the business, read customer chats, the webhook log, the runtime
# AI-key setter). Your own account's id — Supabase dashboard → Authentication →
# Users. With this empty, NOBODY is an operator and those routes return 403.
OPERATOR_USER_IDS=
# Comma-separated browser origins allowed to call the API. The Vercel
# deployment and the tunnel domain belong here.
#   CORS_ORIGINS=https://dukaan-ai-beta.vercel.app,https://your-ngrok-domain.ngrok-free.dev
CORS_ORIGINS=
# The legacy Baileys/n8n console at /ops. It can re-pair the WhatsApp session,
# so it is OFF unless set to exactly 1. Prefer the POS settings screen for
# linking; turn this on only to reach the console deliberately.
# ENABLE_OPS_CONSOLE=1


# ── Bot runtime ──────────────────────────────────────────────────────────────
PORT=5001
# Where the WhatsApp session credentials are stored. The bot resolves this
# against its own directory (whatsapp/), so `./auth_info` means
# whatsapp/auth_info — do NOT prefix it with `whatsapp/`, or the bot starts with
# no session and every shopkeeper has to re-scan the QR.
AUTH_DIR=./auth_info
# Order and catalog stores. Default to ./whatsapp/… when unset.
# DUKAN_ORDERS_FILE=./whatsapp/dukan_orders.json
# DUKAN_CATALOG_FILE=./whatsapp/dukan_catalog.json


# ── Single-shop fallback (optional) ──────────────────────────────────────────
# Used ONLY when Supabase is not configured. Without it (and without a Supabase
# service key) the bot refuses every order and logs why — it never writes an
# ownerless order.
# DUKAN_DEFAULT_OWNER_ID=


# ── Delivery radius ──────────────────────────────────────────────────────────
# A shop farther than this from the customer's pin does not serve them. Default 5 km.
DUKAN_MAX_DELIVERY_KM=5
