# WhatsApp Baileys & n8n Bridge Configuration

# Server Port
# Must match the Vite dev-server proxy target (see vite.config.ts -> server.proxy).
PORT=5001

# n8n Webhook URL (Optional, can also be configured in Web UI)
# Example: http://localhost:5678/webhook/whatsapp
N8N_WEBHOOK_URL=

# Session directory for storing WhatsApp credentials
AUTH_DIR=./auth_info

# OpenRouter AI Configuration
# Get your free/paid key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Owner of the local shop, used until the shop registry (store/shops.json /
# Supabase) is wired. Orders created by the bot carry this account id so they
# reach exactly one shopkeeper's app.
# Set it to the merchant's Supabase user id (Supabase -> Authentication -> Users).
# If unset, bot-created orders have NO owner and appear in no account.
DUKAN_DEFAULT_OWNER_ID=
